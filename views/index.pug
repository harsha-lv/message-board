doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
  body
    a(href="/new") Send new message 
    h1= title
    each message in messages
      article
        p
          strong User: 
          | #{message.user}
        p
          strong Message: 
          | #{message.text}
        p
          strong Added: 
          | #{message.added}
        a(href=`/${message.user}`) Open 
