doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || "New Message"
    link(rel="stylesheet" href="/style.css")
  body
    .app-container
      .form-card
        header.app-header
          h1.brand-title New Message
          a.btn.btn-secondary.btn-sm(href="/") &larr; Back to Board

        if error
          .alert-error= error

        form(method="POST" action="/new")
          .form-group
            label.form-label(for="messageUser") Author
            input#messageUser.form-input(type="text" name="messageUser" placeholder="Your name (e.g. harsha)" required)
          .form-group
            label.form-label(for="messageText") Message
            input#messageText.form-input(type="text" name="messageText" placeholder="Write your message here..." required)
          .form-group
            label.form-label(for="messageDate") Date
            input#messageDate.form-input(type="date" name="messageDate")
          .form-actions
            button#submit-btn.btn.btn-primary(type="submit") Submit
            a.btn.btn-secondary(href="/") Cancel
